# Copy to .env and fill in.

# Login password for this app, as a bcrypt hash. Generate one with:
#   docker compose run --rm app python -m app.hash_password
# Keep the single quotes: the hash contains "$" characters.
BAW_PASSWORD_HASH='$2b$12$replace.me.with.your.hash'

# Domain pointing at this server (Caddy gets the HTTPS certificate for it).
DOMAIN=anki.example.com

# Optional: default to a self-hosted Anki sync server instead of AnkiWeb.
# (You can also enter one on the Settings page when connecting.)
# BAW_SYNC_ENDPOINT=https://sync.example.com/

# Optional: autosync timing, in seconds.
# BAW_AUTOSYNC_IDLE_SECONDS=60
# BAW_AUTOSYNC_POLL_SECONDS=600
